# Deja — environment
# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# ---- CockroachDB Cloud -------------------------------------------------------
# Printed by infra/provision.sh. App role: full read/write on the app schema.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:26257/deja?sslmode=verify-full"

# Read-only role used by the MCP server. The agent must never be able to write
# memory or read another tenant. Different credential on purpose.
DATABASE_URL_READONLY="postgresql://deja_agent_ro:PASSWORD@HOST:26257/deja?sslmode=verify-full"

# ---- AWS Bedrock -------------------------------------------------------------
# Quotas and model availability are per region. Keep everything in one region so
# the embedding model and the chat model can't drift apart.
AWS_REGION="eu-west-1"

# Preferred: a Bedrock API key (Bedrock console → API keys → generate long-term
# key). One bearer token, no IAM user required.
AWS_BEARER_TOKEN_BEDROCK=""

# Fallback only, if you'd rather use an IAM user with AmazonBedrockFullAccess.
# Leave blank when using the bearer token above.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# These are cross-region inference profile ids, not raw model ids — the bare id
# will fail. The prefix must match AWS_REGION's geography: "eu." for eu-*,
# "us." for us-*. Moving region means changing both lines below.
# Canonicalization runs on every intent: high volume, keep it cheap.
BEDROCK_MODEL_FAST="eu.anthropic.claude-haiku-4-5-20251001-v1:0"
# Brief generation and rule compilation: reasoning quality matters.
BEDROCK_MODEL_REASONING="eu.anthropic.claude-sonnet-5-20260514-v1:0"
# 1024-dim, matches VECTOR(1024) in the schema. Changing this means reindexing.
BEDROCK_MODEL_EMBED="amazon.titan-embed-text-v2:0"
EMBED_DIMS="1024"

# ---- Price data --------------------------------------------------------------
# Single endpoint, polled by cron for SL/TP settlement. No websockets by design.
PRICE_API_BASE="https://api.coinbase.com/v2"

# ---- App ---------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
